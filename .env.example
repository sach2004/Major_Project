# ── AI Software Archaeologist ──────────────────────────────────────────
# Local SQLite database (created automatically — do not change)
DATABASE_URL="file:./dev.db?socket_timeout=30"

# LLM keys — set ONE or BOTH. If one is missing the app uses the other.
# (You can also paste them in the app under Settings instead.)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Optional
# LLM_PROVIDER="auto"        # auto | gemini | openai  (which to try first)
# GITHUB_TOKEN=""            # only for PRIVATE GitHub repos
# SYNC_CRON="*/30 * * * *"   # auto-sync schedule (built-in cron)
# CRON_SECRET=""             # protects /api/cron/sync if you expose it
